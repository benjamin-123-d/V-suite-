# ---------------------------------------------------------------------------
# GARPIS Formation — modele de configuration
# Copiez ce fichier en .env pour le developpement local.
# En production Clever Cloud, ces cles se saisissent dans la console
# (Application > Variables d'environnement), pas dans un fichier.
# ---------------------------------------------------------------------------

APP_NAME="GARPIS Formation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Porto-Novo
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de donnees ---------------------------------------------------------
# PostgreSQL en production. Sur Clever Cloud, l'add-on injecte POSTGRESQL_ADDON_*
# et config/database.php les lit tout seul : rien a saisir ici.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=garpis
DB_USERNAME=garpis
DB_PASSWORD=

# Pour un essai rapide sans PostgreSQL :
# DB_CONNECTION=sqlite
# DB_DATABASE=/chemin/absolu/vers/database/garpis.sqlite

# --- Sessions, cache, files d'attente ---------------------------------------
# Les trois passent par la base : aucune instance ne garde d'etat en local,
# ce qui reste vrai le jour ou l'application tourne sur plusieurs instances.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_COOKIE=garpis_session
# A laisser a false en local (http), true en production (https).
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Parametres GARPIS -------------------------------------------------------
GARPIS_RAISON_SOCIALE="ONG GARPIS"
GARPIS_EMAIL=garpis62@gmail.com
GARPIS_TELEPHONE="+229 96 66 71 94"
GARPIS_SIGNATAIRE="Mme Alida ALINGO TOHIO"
GARPIS_FONCTION_SIGNATAIRE=Présidente
GARPIS_IFU=

# URL encodee dans les QR codes des attestations.
# Une fois des attestations imprimees, elle ne peut plus changer.
GARPIS_URL_VERIFICATION=

GARPIS_PLAFOND_REMISE_DE=15
GARPIS_MONTANT_DUPLICATA=2000

# Vide = paiement en ligne desactive, le duplicata se regle au comptoir.
GARPIS_LIEN_PAIEMENT=

# --- Assistant IA (facultatif) ----------------------------------------------
# Vide = assistant desactive, le reste de l'application fonctionne normalement.
ANTHROPIC_API_KEY=
GARPIS_IA_MODELE=claude-sonnet-4-6
GARPIS_IA_PLAFOND_MENSUEL_XOF=15000